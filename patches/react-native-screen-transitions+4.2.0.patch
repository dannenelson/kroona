+/**
+ * KROONA PATCH (patch-package, patches/react-native-screen-transitions+4.2.0.patch):
+ * distansbaserad stängning på den vertikala axeln. Bibliotekets egen regel
+ * kräver förflyttning/höjd + hastighet/höjd × impact > 0,5, så ett lugnt kort
+ * drag stänger aldrig. Har appen satt globalThis.__kroonaDismissMinDistance (px)
+ * på UI-runtime stänger ett drag nedåt på minst så många px, så länge det inte
+ * flickas tillbaka uppåt snabbare än __kroonaDismissCancelVelocity (px/s).
+ * Värdena är tokens i appens theme/motion.ts. Utan globals: oförändrat beteende.
+ */
+const shouldDismissByMinDistance = (
+	positiveDirectionEnabled: boolean,
+	negativeDirectionEnabled: boolean,
+	translation: number,
+	velocity: number,
+) => {
+	"worklet";
+	const g = globalThis as unknown as {
+		__kroonaDismissMinDistance?: number;
+		__kroonaDismissCancelVelocity?: number;
+	};
+	const minDistance = g.__kroonaDismissMinDistance;
+	if (minDistance === undefined || minDistance <= 0) return false;
+	if (
+		!isMovingTowardDismiss(
+			positiveDirectionEnabled,
+			negativeDirectionEnabled,
+			translation,
+		)
+	) {
+		return false;
+	}
+	const sign = Math.sign(translation);
+	const cancelVelocity = g.__kroonaDismissCancelVelocity ?? 0;
+	return Math.abs(translation) >= minDistance && velocity * sign > -cancelVelocity;
+};
